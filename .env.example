# Meta Model API (OpenAI-compatible). Never commit the real .env.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3
IMAGE_MODEL_ID=muse-image-1.0
VOICE_MODEL_ID=muse-voice-transcribe-1.0

# openrouteservice (walking directions)
ORS_API_KEY=

# Own spend guard: the Billing Spend Limit only alerts, it does not stop calls.
DAILY_BUDGET_USD=15

# true = every provider reads from fixtures/, no network
USE_MOCKS=false

# Postgres for the deployed app (Neon pooled URL, sslmode=require). Empty = local SQLite.
DATABASE_URL=

# Text jobs on Muse Spark Open via a hosted partner (off by default; docs/fallback_open_weights.md).
TEXT_PROVIDER=meta
SPARK_OPEN_BASE_URL=https://api.fireworks.ai/inference/v1
SPARK_OPEN_MODEL=accounts/fireworks/models/muse-spark-open
SPARK_OPEN_API_KEY=
SPARK_OPEN_INPUT_PER_M=0
SPARK_OPEN_OUTPUT_PER_M=0
SPARK_OPEN_JSON_MODE=json_schema
